#!/usr/bin/env bash

# ログインしてトークンを取る（管理者デモでログイン）
TOKEN=$(curl -s -X POST http://localhost:3000/api/v1/login \
  -H "Content-Type: application/json" \
  -d '{"email_address": "admin@example.com", "password": "password"}' \
  | jq -r '.token')
# そのトークンを持ってエンドポイントにアクセスする
# -Xの後を変更すれば他のルーターで繋がる
curl -X POST http://localhost:3000/api/v1/"$1" \
  -H "Authorization: Bearer $TOKEN"